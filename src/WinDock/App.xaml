<Application x:Class="WinDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Theme & UI Brushes (Defined for DynamicResource support) -->
        <SolidColorBrush x:Key="BarBackgroundBrush" Color="#111318" />
        <SolidColorBrush x:Key="BarBorderBrush" Color="#223344" />
        <SolidColorBrush x:Key="PillBackgroundBrush" Color="#1A1E29" />
        <SolidColorBrush x:Key="PillHoverBrush" Color="#262F40" />
        <SolidColorBrush x:Key="PillActiveBrush" Color="#2E3A50" />
        
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#A855F7" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="AccentColorBrush" Color="#38BDF8" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

        <!-- Window & Dialog Brushes -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1117" />
        <SolidColorBrush x:Key="WindowCardBrush" Color="#161B24" />
        <SolidColorBrush x:Key="WindowCardHoverBrush" Color="#212836" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#2B3442" />

        <!-- Standard Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Crisp Font & Rendering Defaults -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        </Style>
    </Application.Resources>
</Application>