<Application x:Class="WinDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BarBackgroundBrush" Color="#E6111318" />
        <SolidColorBrush x:Key="BarBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PillBackgroundBrush" Color="#1F2430" />
        <SolidColorBrush x:Key="PillHoverBrush" Color="#2C3344" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#A855F7" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    </Application.Resources>
</Application>
