                        <Button Content="1x3" ToolTip="1x3 (124px) - Expandido" Command="{Binding SetSize1x3Command}" Padding="7,3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSize1x3}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 4. REORDER ◄ / ► -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                        <Button Style="{StaticResource CardActionButtonStyle}" ToolTip="Mover para esquerda na Dock"
                                Command="{Binding MoveLeftCommand}"
                                Padding="7,3" Margin="0,0,3,0">
                            <TextBlock Text="◄" FontSize="9" />
                        </Button>
                        <Button Style="{StaticResource CardActionButtonStyle}" ToolTip="Mover para direita na Dock"
                                Command="{Binding MoveRightCommand}"
                                Padding="7,3">
                            <TextBlock Text="►" FontSize="9" />
                        </Button>
                    </StackPanel>

                    <!-- 5. TOGGLE SWITCH -->
                    <CheckBox Grid.Column="4"
                              Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding IsVisible}"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              ToolTip="Ativar / Desativar este widget na Dock" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="hardware">
                    <Setter TargetName="HardwarePreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="media">
                    <Setter TargetName="MediaPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam">
                    <Setter TargetName="SteamJumpInPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-jump-in">
                    <Setter TargetName="SteamJumpInPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-recent">
                    <Setter TargetName="SteamRecentPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-downloads">
                    <Setter TargetName="SteamDownloadsPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-now-playing">
                    <Setter TargetName="SteamNowPlayingPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-hub">
                    <Setter TargetName="SteamHubPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-storage">
                    <Setter TargetName="SteamStoragePreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="discord">
                    <Setter TargetName="DiscordPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="ai">
                    <Setter TargetName="AiPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="clock">
                    <Setter TargetName="ClockPreview" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= UNIFIED DOCK STRIP ITEM TEMPLATE (APPS + WIDGETS JUNTOS) ================= -->
        <DataTemplate x:Key="UnifiedDockStripItemTemplate">
            <Border Background="{DynamicResource PillBackgroundBrush}"
                    BorderBrush="{DynamicResource BarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Icon (App Icon or Widget Glyph) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Title & Info -->
                        <ColumnDefinition Width="*" />
                        <!-- Badges (Widget / App / Pinned / Open) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Reorder ◄ / ► (Mesmo motor para ambos!) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Pin / Unpin 1-Click Action -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Container -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="5" Background="#10141D" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="AppIconImg" Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
                            <TextBlock x:Name="WidgetGlyphTxt" Text="{Binding IconGlyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Title & Process / Status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                            <!-- Focused Badge -->
                            <Border x:Name="FocusBadge" Background="#2038BDF8" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="Foco" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SubInfoTxt" Text="{Binding ProcessName}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Badges -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <!-- Widget or App Tag Badge -->
                        <Border x:Name="TypeBadge" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" Background="#15202E">
                            <TextBlock x:Name="TypeBadgeTxt" Text="App" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Pinned State Badge -->
                        <Border x:Name="PinnedBadge" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" Background="#2238BDF8" Visibility="Collapsed">
                            <TextBlock Text="📌 Fixado" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                        </Border>

                        <!-- Open/Running Badge -->
                        <Border x:Name="OpenBadge" CornerRadius="4" Padding="6,2" Background="#1822C55E" Visibility="Collapsed">
                            <TextBlock Text="● Aberto" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Reorder ◄ / ► (Unified Motor) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTip="Mover para a esquerda na barra"
                                Command="{Binding MoveLeftCommand}"
                                Padding="8,4" Margin="0,0,3,0">
                            <TextBlock Text="◄" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTip="Mover para a direita na barra"
                                Command="{Binding MoveRightCommand}"
                                Padding="8,4">
                            <TextBlock Text="►" FontSize="10" />
                        </Button>
                    </StackPanel>

                    <!-- Pin / Unpin 1-Click Action (Apps only) -->
                    <Button x:Name="PinActionBtn"
                            Grid.Column="4"
                            Command="{Binding TogglePinCommand}"
                            Padding="10,4"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                                <Setter Property="Content" Value="📌 Fixar" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Content" Value="Desafixar" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentRedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- If item is a Widget -->
                <DataTrigger Binding="{Binding IsWidget}" Value="True">
                    <Setter TargetName="AppIconImg" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="WidgetGlyphTxt" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TypeBadge" Property="Background" Value="#25A855F7" />
                    <Setter TargetName="TypeBadgeTxt" Property="Text" Value="🧩 Widget" />
                    <Setter TargetName="TypeBadgeTxt" Property="Foreground" Value="{DynamicResource AccentPurpleBrush}" />
                    <Setter TargetName="SubInfoTxt" Property="Text" Value="Item Modular da Dock" />
                    <Setter TargetName="PinActionBtn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- If app is Pinned -->
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="PinnedBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- If app is Open -->
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="OpenBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- If app has Focus -->
                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                    <Setter TargetName="FocusBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Standard DockAppItem Template -->
        <DataTemplate x:Key="DockAppItemTemplate">
            <Border Background="{DynamicResource PillBackgroundBrush}"
                    BorderBrush="{DynamicResource BarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="5" Background="#10141D" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                                <Border Background="#2038BDF8" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                        Visibility="{Binding IsFocused, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Foco" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ProcessName}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#15202E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Background" Value="#2238BDF8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="9" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Não fixado" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="📌 Fixado" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Border CornerRadius="4" Padding="6,2"
                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
                                Background="#1822C55E">
                            <TextBlock Text="● Aberto" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTip="Mover aplicativo para a esquerda na Dock"
                                Command="{Binding MoveLeftCommand}"
                                Padding="8,4" Margin="0,0,3,0">
                            <TextBlock Text="◄" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource CardActionButtonStyle}"
                                ToolTip="Mover aplicativo para a direita na Dock"
                                Command="{Binding MoveRightCommand}"
                                Padding="8,4">
                            <TextBlock Text="►" FontSize="10" />
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Command="{Binding TogglePinCommand}"
                            Padding="10,4"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                                <Setter Property="Content" Value="📌 Fixar" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Content" Value="Desafixar" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentRedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar / Window Chrome -->
            <RowDefinition Height="42" />
            <!-- Main Content Area: Sidebar + Tab Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource WindowCardBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="9"
                            Background="{DynamicResource AccentColorBrush}"
                            Margin="0,0,8,0">
                        <TextBlock Text="✦" FontSize="10" FontWeight="Bold" Foreground="#0B0E14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="WinDock" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="— Configurações &amp; Personalização" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CardActionButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Padding="8,2" Margin="0,0,4,0"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimizar">
                        <TextBlock Text="─" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource CardActionButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Padding="8,2"
                            Click="CloseButton_Click"
                            ToolTip="Fechar Janela">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource AccentRedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN LAYOUT ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT SIDEBAR ================= -->
            <Border Grid.Column="0"
                    Background="{DynamicResource WindowCardBrush}"
                    Padding="12,12,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- SEARCH / FILTER BOX -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PillBackgroundBrush}"
                            BorderBrush="{DynamicResource BarBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource TextMutedBrush}"
                                  VerticalAlignment="Center" Margin="2,0,6,0" />

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentColorBrush}"
                                     FontSize="11.5"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="Filtrar opções e configurações..." />

                            <Button x:Name="ClearSearchButton"
                                    Grid.Column="2"
                                    Style="{StaticResource MiniPreviewButtonStyle}"
                                    Width="16" Height="16"
                                    Click="ClearSearchButton_Click"
                                    Visibility="Collapsed"
                                    ToolTip="Limpar busca">
                                <TextBlock Text="✕" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- CATEGORIES NAVIGATION LIST -->
                    <ListBox x:Name="SidebarList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             SelectionMode="Single"
                             SelectedIndex="0"
                             SelectionChanged="SidebarList_SelectionChanged">

                        <!-- Item 0: Widgets da Dock -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource AccentCyanBrush}"
                                      VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Widgets da Dock" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Prévia &amp; Dimensionamento" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <!-- Item 1: Apps & Ordem da Dock -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M12 2.5s-4 4.5-4 9.5c0 2.2.8 4.2 2 5.5v3.5l2-1 2 1v-3.5c1.2-1.3 2-3.3 2-5.5 0-5-4-9.5-4-9.5zm-1 9a1 1 0 1 1 2 0 1 1 0 0 1-2 0z"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource AccentPurpleBrush}"
                                      VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Apps &amp; Ordem da Dock" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Fila Unificada &amp; Fixados" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <!-- Item 2: Temas & Cores -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10c1.38 0 2.5-1.12 2.5-2.5 0-.61-.23-1.2-.64-1.67-.08-.1-.13-.23-.13-.33 0-.28.22-.5.5-.5H18c2.21 0 4-1.79 4-4 0-5.52-4.48-10-10-10zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 8 6.5 8s1.5.67 1.5 1.5S7.33 11 6.5 11zm3-4C8.67 7 8 6.33 8 5.5S8.67 4 9.5 4s1.5.67 1.5 1.5S10.33 7 9.5 7zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 4 14.5 4s1.5.67 1.5 1.5S15.33 7 14.5 7zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 8 17.5 8s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource AccentAmberBrush}"
                                      VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Temas &amp; Cores" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Estilos &amp; Cores de Destaque" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <!-- Item 3: Comportamento & Sistema -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource AccentGreenBrush}"
                                      VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Comportamento" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Posição &amp; Barra Nativa" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <!-- Item 4: Ver Tudo -->
                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M4 14h4v-4H4v4zm0 5h4v-4H4v4zM4 9h4V5H4v4zm5 5h12v-4H9v4zm0 5h12v-4H9v4zM9 5v4h12V5H9z"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Ver Tudo" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Todas as Seções" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                    </ListBox>

                    <!-- SIDEBAR FOOTER STATUS -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource PillBackgroundBrush}"
                            BorderBrush="{DynamicResource BarBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="{DynamicResource AccentGreenBrush}"
                                    Margin="0,0,8,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="WinDock v6.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Dark Glassmorphic Dock" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- VERTICAL DIVIDER -->
            <Border Grid.Column="1" Background="{DynamicResource WindowBorderBrush}" />

            <!-- ================= RIGHT CONTENT AREA ================= -->
            <Grid Grid.Column="2" Margin="18,14,18,16">

                <TabControl SelectedIndex="{Binding SelectedIndex, ElementName=SidebarList}"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- ================= TAB 0: WIDGETS DA DOCK (MINIMALIST 52PX ROWS) ================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCardStyle}" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Widgets Modulares da Dock" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Alterne tamanhos (1x1, 1x2, 1x3), ordene com ◄ / ► e visualize a prévia real e viva no mini-slot." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="6 Widgets Ativos" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding DockWidgets}"
                                              ItemTemplate="{StaticResource CompactWidgetRowTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= TAB 1: APPS & ORDEM DA DOCK (UNIFIED MOTOR) ================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- SECTION 1: UNIFIED DOCK STRIP ITEMS (ÍCONES + WIDGETS JUNTOS NA ORDEM REAL) -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Faixa Unificada da Barra da Dock (Ícones + Widgets Juntos)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="Esta é a ordem real e completa da barra da Dock. Widgets e aplicativos dividem a mesma linha e podem ser livremente intercalados na ordem que você desejar."
                                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                        <!-- Unified Strip Items (falls back to DockApps if DockStripItems is loading) -->
                                        <ItemsControl ItemsSource="{Binding DockStripItems}"
                                                      ItemTemplate="{StaticResource UnifiedDockStripItemTemplate}" />
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 2: 1-CLICK PIN OPEN WINDOWS -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Janelas Abertas no Momento (Fixar com 1 Clique)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="Clique no botão ao lado de qualquer janela aberta para fixá-la instantaneamente na Dock."
                                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                        <ItemsControl ItemsSource="{Binding OpenAppsForPinning}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PillBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BarBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10,6"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" Stretch="Uniform" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="440" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding ProcessName}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Button Grid.Column="1"
                                                                    Content="{Binding ButtonText}"
                                                                    Command="{Binding TogglePinCommand}"
                                                                    Padding="10,4"
                                                                    VerticalAlignment="Center">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                                                                <Setter Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 3: PINNED SHORTCUTS LIST -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Atalhos Salvos nas Configurações da Dock" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="Gerencie, reordene ou remova atalhos salvos."
                                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                        <ItemsControl ItemsSource="{Binding PinnedShortcuts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PillBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BarBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10,6"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="{Binding CustomIcon}" Width="18" Height="18" Margin="0,0,8,0" Stretch="Uniform" />
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding TargetPath}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource CardActionButtonStyle}"
                                                                        Content="▲"
                                                                        ToolTip="Mover para cima"
                                                                        Command="{Binding DataContext.MoveShortcutUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="6,2" Margin="0,0,3,0" />
                                                                <Button Style="{StaticResource CardActionButtonStyle}"
                                                                        Content="▼"
                                                                        ToolTip="Mover para baixo"
                                                                        Command="{Binding DataContext.MoveShortcutDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="6,2" Margin="0,0,6,0" />
                                                                <Button Style="{StaticResource CardActionButtonStyle}"
                                                                        Content="🗑"
                                                                        ToolTip="Remover atalho"
                                                                        Command="{Binding DataContext.RemoveShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="6,2" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 4: MANUAL SHORTCUT ADDITION -->
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Adicionar Atalho Manualmente" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="Selecione um arquivo executável (.exe) ou atalho (.lnk) para fixar na Dock com seu ícone real."
                                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="ShortcutNameTextBox"
                                                     Grid.Column="0"
                                                     Margin="0,0,8,0"
                                                     Padding="6,4"
                                                     FontSize="11"
                                                     Background="{DynamicResource PillBackgroundBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BarBorderBrush}"
                                                     ToolTip="Nome do Atalho (ex: Chrome, VS Code)" />

                                            <TextBox x:Name="ShortcutPathTextBox"
                                                     Grid.Column="1"
                                                     Margin="0,0,8,0"
                                                     Padding="6,4"
                                                     FontSize="11"
                                                     Background="{DynamicResource PillBackgroundBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BarBorderBrush}"
                                                     ToolTip="Caminho do arquivo ou executável" />

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource CardActionButtonStyle}"
                                                    Content="Procurar..."
                                                    Click="BrowseFileButton_Click"
                                                    Margin="0,0,8,0" />
                                        </Grid>

                                        <Button Style="{StaticResource CardActionButtonStyle}"
                                                Content="+ Adicionar à Dock"
                                                HorizontalAlignment="Left"
                                                Click="AddShortcutButton_Click" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= TAB 2: TEMAS & CORES ================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Temas Pré-definidos" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="Selecione um estilo visual para aplicar instantaneamente na Dock e janelas."
                                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                        <ItemsControl ItemsSource="{Binding AvailableThemes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PillBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BarBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12,10"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource CardActionButtonStyle}"
                                                                    Content="Aplicar Tema"
                                                                    Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Cor de Destaque (Accent)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="Escolha o tom de destaque para os indicadores de foco, gauges e badges."
                                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                        <ItemsControl ItemsSource="{Binding AvailableAccents}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource CardActionButtonStyle}"
                                                            Margin="0,0,8,8"
                                                            Padding="8,5"
                                                            Command="{Binding DataContext.ApplyAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Brush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= TAB 3: COMPORTAMENTO & SISTEMA ================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Posicionamento &amp; Integração com Windows" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="Gerencie a posição da WinDock e o comportamento da barra nativa do sistema."
                                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                        <!-- Dock Edge Position -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Posição da Dock na Tela" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="A WinDock substitui a barra nativa ficando posicionada na Base ou no Topo."
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource CardActionButtonStyle}"
                                                    Command="{Binding ToggleBarEdgeCommand}"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Posição Atual: " FontSize="11" />
                                                    <TextBlock Text="{Binding EdgeLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Native Taskbar Toggle -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Barra de Tarefas Nativa do Windows" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Oculte a barra padrão do Windows para que o WinDock ocupe exatamente seu espaço."
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource CardActionButtonStyle}"
                                                    Command="{Binding ToggleNativeTaskbarCommand}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NativeTaskbarStatusText}" FontSize="11" />
                                            </Button>
                                        </Grid>

                                        <!-- Desktop Widgets Toggle -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Widgets no Desktop (Wallpaper Layer)" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Painel estendido com telemetria e atalhos afixado diretamente no papel de parede."
                                                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource CardActionButtonStyle}"
                                                    Command="{Binding ToggleWidgetsCommand}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WidgetsToggleText}" FontSize="11" />
                                            </Button>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= TAB 4: VER TUDO (SEARCH & ALL SECTIONS) ================= -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- GROUP 1: WIDGETS DA DOCK -->
                                <StackPanel x:Name="WidgetsGroup">
                                    <Border Style="{StaticResource SettingsCardStyle}" Padding="12,10" Margin="0,0,0,8">
                                        <TextBlock Text="🧩 Widgets Modulares da Dock (Prévia Minimalista)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding DockWidgets}"
                                                  ItemTemplate="{StaticResource CompactWidgetRowTemplate}" />
                                </StackPanel>

                                <!-- GROUP 2: FAIXA UNIFICADA & APPS -->
                                <StackPanel x:Name="AppsGroup" Margin="0,8,0,0">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="🚀 Faixa Unificada da Barra da Dock (Ícones + Widgets)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="Reordene com ◄ / ► qualquer item (widget ou app) misturado na barra."
                                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding DockStripItems}"
                                                          ItemTemplate="{StaticResource UnifiedDockStripItemTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- GROUP 3: ATALHOS & JANELAS ABERTAS -->
                                <StackPanel x:Name="ShortcutsGroup" Margin="0,8,0,0">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="📌 Janelas Abertas (Fixação Rápida)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="Atalhos salvos e fixação com 1 clique." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding OpenAppsForPinning}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource PillBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BarBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,6"
                                                                Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" Stretch="Uniform" />
                                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="380" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Content="{Binding ButtonText}"
                                                                        Command="{Binding TogglePinCommand}"
                                                                        Padding="10,4"
                                                                        Style="{StaticResource CardActionButtonStyle}"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- GROUP 4: TEMAS & CORES -->
                                <StackPanel x:Name="ThemesGroup" Margin="0,8,0,0">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="🎨 Temas &amp; Cores de Destaque" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="Personalização visual da Dock." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

                                            <ItemsControl ItemsSource="{Binding AvailableAccents}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource CardActionButtonStyle}"
                                                                Margin="0,0,8,8"
                                                                Padding="8,5"
                                                                Command="{Binding DataContext.ApplyAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Brush}" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- GROUP 5: COMPORTAMENTO & SISTEMA -->
                                <StackPanel x:Name="BehaviorGroup" Margin="0,8,0,0">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="⚙ Comportamento &amp; Posição" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="Posicionamento e integração nativa com o Windows." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Posição da Dock na Tela" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Style="{StaticResource CardActionButtonStyle}" Command="{Binding ToggleBarEdgeCommand}">
                                                    <TextBlock Text="{Binding EdgeLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}" FontSize="11" />
                                                </Button>
                                            </Grid>

                                            <!-- Tamanho da Barra & Escala dos Ícones -->
                                            <Border Background="{DynamicResource PillBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BarBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,10"
                                                    Margin="0,4,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📏 Tamanho da Dock &amp; Escala" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text=" (arraste a borda ou Ctrl + Scroll)" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,1,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding BarHeightText}" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <Slider Minimum="36" Maximum="80"
                                                            Value="{Binding BarHeightDip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            TickFrequency="2" IsSnapToTickEnabled="True"
                                                            Margin="0,2,0,8" />

                                                    <!-- Presets Rápidos -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="Presets:" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Button Content="Compacto (38px)" Style="{StaticResource CardActionButtonStyle}" Command="{Binding SetBarHeightCommand}" CommandParameter="38" Padding="6,2" Margin="0,0,4,0" FontSize="10" />
                                                        <Button Content="Padrão (48px)" Style="{StaticResource CardActionButtonStyle}" Command="{Binding SetBarHeightCommand}" CommandParameter="48" Padding="6,2" Margin="0,0,4,0" FontSize="10" />
                                                        <Button Content="Médio (58px)" Style="{StaticResource CardActionButtonStyle}" Command="{Binding SetBarHeightCommand}" CommandParameter="58" Padding="6,2" Margin="0,0,4,0" FontSize="10" />
                                                        <Button Content="Grande (68px)" Style="{StaticResource CardActionButtonStyle}" Command="{Binding SetBarHeightCommand}" CommandParameter="68" Padding="6,2" FontSize="10" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Barra de Tarefas Nativa do Windows" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Style="{StaticResource CardActionButtonStyle}" Command="{Binding ToggleNativeTaskbarCommand}">
                                                    <TextBlock Text="{Binding NativeTaskbarStatusText}" FontSize="11" />
                                                </Button>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Widgets no Desktop (Wallpaper)" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Style="{StaticResource CardActionButtonStyle}" Command="{Binding ToggleWidgetsCommand}">
                                                    <TextBlock Text="{Binding WidgetsToggleText}" FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
