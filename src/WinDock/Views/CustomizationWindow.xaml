<Window x:Class="WinDock.Views.CustomizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock — Personalização &amp; Configurações"
        Width="760"
        Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontWeight="Normal">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="8" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Tab Item Header Style -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Action Button Style -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar / Window Chrome -->
            <RowDefinition Height="42" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource WindowCardBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Window Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="8"
                            Background="{DynamicResource AccentColorBrush}"
                            Margin="0,0,8,0">
                        <TextBlock Text="✦" FontSize="10" FontWeight="Bold" Foreground="#0B0E14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="WinDock" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="— Personalização &amp; Configurações" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CardActionButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Padding="8,2" Margin="0,0,4,0"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimizar">
                        <TextBlock Text="─" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource CardActionButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Padding="8,2"
                            Click="CloseButton_Click"
                            ToolTip="Fechar Janela">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource AccentRedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN TABS ================= -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="14,10,14,14">

            <!-- TAB 1: TEMAS & CORES -->
            <TabItem Header="🎨 Temas &amp; Cores" Style="{StaticResource ModernTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,6,0,0">

                        <!-- Theme Presets Card -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Temas Pré-definidos" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Selecione um estilo visual para aplicar instantaneamente na Dock e janelas."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding AvailableThemes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PillBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BarBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource CardActionButtonStyle}"
                                                            Content="Aplicar Tema"
                                                            Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Accent Color Palette Card -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Cor de Destaque (Accent)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Escolha o tom de destaque para os indicadores de foco, gauges e badges."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding AvailableAccents}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CardActionButtonStyle}"
                                                    Margin="0,0,8,8"
                                                    Padding="8,5"
                                                    Command="{Binding DataContext.ApplyAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Brush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: WIDGETS DA DOCK -->
            <TabItem Header="🧩 Widgets da Dock" Style="{StaticResource ModernTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,6,0,0">

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Hierarquia Unificada: Widgets Modulares" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Todos os itens na dock compartilham a mesma linha e hierarquia. Você pode alterar o tamanho dos widgets entre 1x1 (40px), 1x2 (82px) e 1x3 (124px), ativá-los ou reordená-los."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding DockWidgets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PillBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BarBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,8"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Icon & Title -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Size Selector (1x1, 1x2, 1x3) -->
                                                        <ColumnDefinition Width="Auto" />
                                                        <!-- Reorder / Visibility -->
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Icon & Description -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Exibir ou ocultar widget na dock" />
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Center: 3-Way Size Buttons -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                        <Button Content="1x1"
                                                                ToolTip="Tamanho 1x1 (40px) - Compacto (1 slot)"
                                                                Command="{Binding SetSize1x1Command}"
                                                                Padding="7,3" Margin="0,0,3,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSize1x1}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                                                            <Setter Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <Button Content="1x2"
                                                                ToolTip="Tamanho 1x2 (82px) - Médio (2 slots)"
                                                                Command="{Binding SetSize1x2Command}"
                                                                Padding="7,3" Margin="0,0,3,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSize1x2}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                                                            <Setter Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>

                                                        <Button Content="1x3"
                                                                ToolTip="Tamanho 1x3 (124px) - Expandido (3 slots)"
                                                                Command="{Binding SetSize1x3Command}"
                                                                Padding="7,3">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSize1x3}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                                                            <Setter Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Right: Reorder Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CardActionButtonStyle}"
                                                                Content="▲"
                                                                ToolTip="Mover para esquerda/início"
                                                                Command="{Binding DataContext.MoveWidgetUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,3" Margin="0,0,3,0" />
                                                        <Button Style="{StaticResource CardActionButtonStyle}"
                                                                Content="▼"
                                                                ToolTip="Mover para direita/fim"
                                                                Command="{Binding DataContext.MoveWidgetDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,3" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: ATALHOS FIXADOS & APPS ABERTOS -->
            <TabItem Header="📌 Atalhos Fixados" Style="{StaticResource ModernTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,6,0,0">

                        <!-- Requirement (2): 1-Click Pinning of Currently Open Windows -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Aplicativos Abertos no Momento (Fixar com 1 Clique)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Clique no botão ao lado de qualquer aplicativo aberto para fixá-lo ou desafixá-lo instantaneamente na Dock."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding OpenAppsForPinning}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PillBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BarBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" Stretch="Uniform" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="440" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ProcessName}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Content="{Binding ButtonText}"
                                                            Command="{Binding TogglePinCommand}"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource CardActionButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                                                        <Setter Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentColorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Pinned Shortcuts List Card -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Atalhos Fixados Atualmente na Dock" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Reordene ou remova atalhos existentes salvos nas configurações da Dock."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding PinnedShortcuts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PillBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BarBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding CustomIcon}" Width="18" Height="18" Margin="0,0,8,0" Stretch="Uniform" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding TargetPath}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CardActionButtonStyle}"
                                                                Content="▲"
                                                                ToolTip="Mover para cima"
                                                                Command="{Binding DataContext.MoveShortcutUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" Margin="0,0,3,0" />
                                                        <Button Style="{StaticResource CardActionButtonStyle}"
                                                                Content="▼"
                                                                ToolTip="Mover para baixo"
                                                                Command="{Binding DataContext.MoveShortcutDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" Margin="0,0,6,0" />
                                                        <Button Style="{StaticResource CardActionButtonStyle}"
                                                                Content="🗑"
                                                                ToolTip="Remover atalho"
                                                                Command="{Binding DataContext.RemoveShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- New Shortcut Form Card -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Adicionar Atalho Manualmente" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Selecione um arquivo executável (.exe) para fixar na Dock com seu ícone real."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="ShortcutNameTextBox"
                                             Grid.Column="0"
                                             Margin="0,0,8,0"
                                             Padding="6,4"
                                             FontSize="11"
                                             Background="{DynamicResource PillBackgroundBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BarBorderBrush}"
                                             ToolTip="Nome do Atalho (ex: Chrome, VS Code)" />

                                    <TextBox x:Name="ShortcutPathTextBox"
                                             Grid.Column="1"
                                             Margin="0,0,8,0"
                                             Padding="6,4"
                                             FontSize="11"
                                             Background="{DynamicResource PillBackgroundBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BarBorderBrush}"
                                             ToolTip="Caminho do arquivo ou executável" />

                                    <Button Grid.Column="2"
                                             Style="{StaticResource CardActionButtonStyle}"
                                             Content="Procurar..."
                                             Click="BrowseFileButton_Click"
                                             Margin="0,0,8,0" />
                                </Grid>

                                <Button Style="{StaticResource CardActionButtonStyle}"
                                        Content="+ Adicionar à Dock"
                                        HorizontalAlignment="Left"
                                        Click="AddShortcutButton_Click" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: COMPORTAMENTO & DOCK -->
            <TabItem Header="⚙ Comportamento" Style="{StaticResource ModernTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,6,0,0">

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Posicionamento &amp; Integração com Windows" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Gerencie a posição da WinDock e o comportamento da barra nativa do sistema."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                <!-- Dock Edge Position -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Posição da Dock na Tela" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="A WinDock substitui a barra nativa ficando posicionada na Base ou no Topo."
                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource CardActionButtonStyle}"
                                            Command="{Binding ToggleBarEdgeCommand}"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Posição Atual: " FontSize="11" />
                                            <TextBlock Text="{Binding EdgeLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentColorBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Native Taskbar Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Barra de Tarefas Nativa do Windows" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Oculte a barra padrão do Windows para que o WinDock ocupe exatamente seu espaço."
                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource CardActionButtonStyle}"
                                            Command="{Binding ToggleNativeTaskbarCommand}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NativeTaskbarStatusText}" FontSize="11" />
                                    </Button>
                                </Grid>

                                <!-- Desktop Widgets Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Widgets no Desktop (Wallpaper Layer)" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="Painel estendido com telemetria e atalhos afixado diretamente no papel de parede."
                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource CardActionButtonStyle}"
                                            Command="{Binding ToggleWidgetsCommand}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WidgetsToggleText}" FontSize="11" />
                                    </Button>
                                </Grid>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
