<Window x:Class="WinDock.Views.CustomizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock — Personalização &amp; Configurações"
        Width="920"
        Height="680"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontWeight="Normal">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="10" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Mini Progress Bar Gauge for Live Widget Previews -->
        <Style x:Key="MiniGaugeStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3.5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="1.75" />
                            <Border x:Name="PART_Track" CornerRadius="1.75" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="1.75" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch Style for CheckBox -->
        <Style x:Key="ModernToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="SwitchTrack"
                                    Grid.Column="0"
                                    Width="36"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="#262F40"
                                    BorderBrush="{DynamicResource BarBorderBrush}"
                                    BorderThickness="1">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="12"
                                         Height="12"
                                         Fill="{DynamicResource TextSecondaryBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="2.5,0,0,0" />
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              ContentSource="Content" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#090D14" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2.5,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Card Action Button Style -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Preview Action Button Style -->
        <Style x:Key="MiniPreviewButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Card Container Style -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Sidebar ListBox Item Style -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,10"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left active indicator bar -->
                                <Border x:Name="ActiveIndicator"
                                        Grid.Column="0"
                                        Background="{DynamicResource AccentColorBrush}"
                                        CornerRadius="1.5"
                                        Visibility="Collapsed"
                                        Margin="-6,2,6,2" />

                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= MINIMALIST 52PX WIDGET ROW TEMPLATE ================= -->
        <DataTemplate x:Key="CompactWidgetRowTemplate">
            <Border Background="{DynamicResource PillBackgroundBrush}"
                    BorderBrush="{DynamicResource BarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="0,0,0,6">
                <Grid Height="40">
                    <Grid.ColumnDefinitions>
                        <!-- Live Mini-Stage (40 / 82 / 124px) -->
                        <ColumnDefinition Width="134" />
                        <!-- Title & Glyph -->
                        <ColumnDefinition Width="*" />
                        <!-- Size Selector (1x1 | 1x2 | 1x3) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Reorder ◄ / ► -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Toggle Switch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. LIVE WIDGET MINI-STAGE -->
                    <Border Grid.Column="0"
                            Width="{Binding TargetWidth}"
                            Height="34"
                            HorizontalAlignment="Left"
                            Background="#0C0F16"
                            BorderBrush="{DynamicResource BarBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Grid>
                            <!-- HARDWARE PREVIEW -->
                            <Grid x:Name="HardwarePreview" Visibility="Collapsed">
                                <!-- 1x1: CPU gauge % + text -->
                                <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="C " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                     Width="30"
                                                     Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Foreground="{DynamicResource AccentCyanBrush}" Margin="0,1.5,0,0" />
                                    </StackPanel>
                                </Grid>
                                <!-- 1x2: CPU & RAM -->
                                <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Vertical" Width="36" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="C " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                         Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Foreground="{DynamicResource AccentCyanBrush}" Margin="0,1.5,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical" Width="36">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="R " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DataContext.RamText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" />
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                         Value="{Binding DataContext.RamPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Foreground="{DynamicResource AccentGreenBrush}" Margin="0,1.5,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <!-- 1x3: CPU, GPU & RAM -->
                                <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Vertical" Width="36" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="C " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                         Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Foreground="{DynamicResource AccentCyanBrush}" Margin="0,1.5,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical" Width="36" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="G " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DataContext.GpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurpleBrush}" />
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                         Value="{Binding DataContext.GpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Foreground="{DynamicResource AccentPurpleBrush}" Margin="0,1.5,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical" Width="36">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="R " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DataContext.RamText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" />
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                         Value="{Binding DataContext.RamPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Foreground="{DynamicResource AccentGreenBrush}" Margin="0,1.5,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- MEDIA PREVIEW -->
                            <Grid x:Name="MediaPreview" Visibility="Collapsed">
                                <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                                    <Path Data="M4 2v12l9-6z M15 2h2v12h-2z"
                                          Stretch="Uniform" Width="12" Height="12"
                                          Fill="{DynamicResource AccentCyanBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M10 15l5-3-5-3v6z M21.5 8c-.2-1-.9-1.8-1.9-2-1.7-.5-8.6-.5-8.6-.5s-6.9 0-8.6.5c-1 .2-1.7 1-1.9 2C0 9.7 0 12 0 12s0 2.3.5 4c.2 1 .9 1.8 1.9 2 1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5c1-.2 1.7-1 1.9-2 .5-1.7.5-4 .5-4s0-2.3-.5-4z"
                                              Width="13" Height="9" Stretch="Uniform" Fill="{DynamicResource AccentRedBrush}" Margin="0,0,4,0" />
                                        <Path Data="M3 2v10l7-5z M12 2h2v10h-2z"
                                              Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                        <Path Data="M2 2v10l6-5z M8 2v10l6-5z M14 2h2v10h-2z"
                                              Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M14 12V2L8 7zm-6 0V2L2 7zm-6 0V2H0v10z"
                                              Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                                        <Path Data="M3 2v10l7-5z M12 2h2v10h-2z"
                                              Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" />
                                        <Path Data="M2 2v10l6-5z M8 2v10l6-5z M14 2h2v10h-2z"
                                              Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,5,0" />
                                        <Path Data="M10 15l5-3-5-3v6z M21.5 8c-.2-1-.9-1.8-1.9-2-1.7-.5-8.6-.5-8.6-.5s-6.9 0-8.6.5c-1 .2-1.7 1-1.9 2C0 9.7 0 12 0 12s0 2.3.5 4c.2 1 .9 1.8 1.9 2 1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5c1-.2 1.7-1 1.9-2 .5-1.7.5-4 .5-4s0-2.3-.5-4z"
                                              Width="13" Height="9" Stretch="Uniform" Fill="{DynamicResource AccentRedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- STEAM PREVIEWS (6 MODULAR WIDGETS WITH REAL ARTWORK & CLIENT ICONS) -->
                            <!-- 1. STEAM: JUMP IN / CONTINUAR JOGANDO (steam-jump-in e legado steam) -->
                            <Grid x:Name="SteamJumpInPreview" Visibility="Collapsed">
                                <!-- 1x1: Jump In Game Icon -->
                                <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                                    <Border CornerRadius="6" Width="26" Height="26" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding DataContext.LastPlayedGameIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>
                                <!-- 1x2: Header background + Icon + Title -->
                                <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                                    <Border CornerRadius="7" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding DataContext.LastPlayedGameHeader, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Stretch="UniformToFill" Opacity="0.32"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border Background="#660A0E18" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0">
                                        <Border CornerRadius="4" Width="22" Height="22" ClipToBounds="True" Margin="0,0,5,0">
                                            <Image Source="{Binding DataContext.LastPlayedGameIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CONTINUAR" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                            <TextBlock Text="{Binding DataContext.LastPlayedGameTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="8.5" FontWeight="SemiBold" MaxWidth="44" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <!-- 1x3: Header + Icon + Full Title -->
                                <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                                    <Border CornerRadius="7" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding DataContext.LastPlayedGameHeader, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Stretch="UniformToFill" Opacity="0.35"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border Background="#550A0E18" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0">
                                        <Border CornerRadius="5" Width="24" Height="24" ClipToBounds="True" Margin="0,0,6,0">
                                            <Image Source="{Binding DataContext.LastPlayedGameIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CONTINUAR JOGANDO" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                            <TextBlock Text="{Binding DataContext.LastPlayedGameTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="9" FontWeight="SemiBold" MaxWidth="80" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- 2. STEAM: JOGOS RECENTES (steam-recent) -->
                            <Grid x:Name="SteamRecentPreview" Visibility="Collapsed">
                                <!-- 1x1: Top 1 Recent Game Icon -->
                                <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                                    <Border CornerRadius="6" Width="26" Height="26" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding DataContext.RecentSteamGame1.IconImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>
                                <!-- 1x2: Top 2 Recent Games -->
                                <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border CornerRadius="5" Width="24" Height="24" ClipToBounds="True" Margin="0,0,4,0">
                                            <Image Source="{Binding DataContext.RecentSteamGame1.IconImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                                        </Border>
                                        <Border CornerRadius="5" Width="24" Height="24" ClipToBounds="True">
                                            <Image Source="{Binding DataContext.RecentSteamGame2.IconImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <!-- 1x3: Top 3 Recent Games Shelf -->
                                <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border CornerRadius="5" Width="24" Height="24" ClipToBounds="True" Margin="0,0,4,0">
                                            <Image Source="{Binding DataContext.RecentSteamGame1.IconImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                                        </Border>
                                        <Border CornerRadius="5" Width="24" Height="24" ClipToBounds="True" Margin="0,0,4,0">
                                            <Image Source="{Binding DataContext.RecentSteamGame2.IconImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                                        </Border>
                                        <Border CornerRadius="5" Width="24" Height="24" ClipToBounds="True">
                                            <Image Source="{Binding DataContext.RecentSteamGame3.IconImage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- 3. STEAM: DOWNLOADS & UPDATES (steam-downloads) -->
                            <Grid x:Name="SteamDownloadsPreview" Visibility="Collapsed">
                                <!-- 1x1: Downloading Game Icon + Pill -->
                                <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                                    <Grid Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border CornerRadius="5" ClipToBounds="True">
                                            <Image Source="{Binding DataContext.SteamDownloadIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                                        </Border>
                                        <Border CornerRadius="3" Background="#DD101826" Padding="2,0.5"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                            <TextBlock Text="{Binding DataContext.SteamDownloadStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="6.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
