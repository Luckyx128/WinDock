<Window x:Class="WinDock.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinDock.ViewModels"
        Title="WinDock"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BarBackgroundBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontWeight="Normal">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Modern Dark Glassmorphic ContextMenu Style -->
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource WindowCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark MenuItem Style -->
        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="6,0,8,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1x1 Standard Icon Slot Button Style (40x40) -->
        <Style x:Key="DockIconSlotStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified 1x1 Dock App Slot Style (40x40) with real icon and active/focus indicator bar -->
        <Style x:Key="UnifiedDockAppSlotStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="2">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <!-- Subtle Focus / Open Indicator Bar at bottom (NO text labels next to icons!) -->
                            <Border x:Name="FocusBar"
                                    Height="2.5"
                                    Width="12"
                                    CornerRadius="1.25"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,2.5"
                                    Background="{DynamicResource TextSecondaryBrush}"
                                    Opacity="0.45"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- If Open, show indicator bar -->
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter TargetName="FocusBar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- If Focused, glowing accent bar and pill highlight -->
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                <Setter TargetName="FocusBar" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                                <Setter TargetName="FocusBar" Property="Width" Value="22" />
                                <Setter TargetName="FocusBar" Property="Opacity" Value="1.0" />
                            </DataTrigger>
                            <!-- If Minimized, subtle dimmed look -->
                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.60" />
                                <Setter TargetName="FocusBar" Property="Width" Value="6" />
                                <Setter TargetName="FocusBar" Property="Opacity" Value="0.25" />
                            </DataTrigger>
                            <!-- If Dragging, semi-translucent with active pill highlight -->
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.65" />
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Transport Button Style -->
        <Style x:Key="MiniActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiniBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MiniBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Gauge Progress Bar -->
        <Style x:Key="MiniGaugeStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3.5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="1.75" />
                            <Border x:Name="PART_Track" CornerRadius="1.75" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="1.75" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplate for 1x1 Dock App Items (Unified with DockStripItems) -->
        <DataTemplate DataType="{x:Type vm:DockAppItem}">
            <Button Style="{StaticResource UnifiedDockAppSlotStyle}"
                    Command="{Binding ClickCommand}"
                    ToolTip="{Binding Title}"
                    PreviewMouseLeftButtonDown="DockItem_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="DockItem_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="DockItem_PreviewMouseLeftButtonUp">
                
                <!-- Right-click dark context menu for any app icon -->
                <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                        <!-- Fixar / Desafixar da Dock: saves to JSON immediately! -->
                        <MenuItem Header="{Binding PinMenuText}"
                                  Command="{Binding TogglePinCommand}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="📌" FontSize="11" Foreground="{DynamicResource AccentColorBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator Background="{DynamicResource BarBorderBrush}" Margin="2,3" />

                        <!-- Mover para a Esquerda / Direita -->
                        <MenuItem Header="◄ Mover para a Esquerda"
                                  Command="{Binding MoveLeftCommand}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="◀" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="► Mover para a Direita"
                                  Command="{Binding MoveRightCommand}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="▶" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator Background="{DynamicResource BarBorderBrush}" Margin="2,3" />

                        <!-- Tamanho da Dock -->
                        <MenuItem Header="Tamanho da Dock" Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="📏" FontSize="11" Foreground="{DynamicResource AccentColorBrush}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Compacto (38px)" Command="{Binding DataContext.SetBarHeightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="38" Style="{StaticResource DarkMenuItemStyle}" />
                            <MenuItem Header="Padrão (48px)" Command="{Binding DataContext.SetBarHeightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="48" Style="{StaticResource DarkMenuItemStyle}" />
                            <MenuItem Header="Médio (58px)" Command="{Binding DataContext.SetBarHeightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="58" Style="{StaticResource DarkMenuItemStyle}" />
                            <MenuItem Header="Grande (68px)" Command="{Binding DataContext.SetBarHeightCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="68" Style="{StaticResource DarkMenuItemStyle}" />
                        </MenuItem>

                        <!-- Personalizar Dock... -->
                        <MenuItem Header="Personalizar Dock..."
                                  Command="{Binding DataContext.OpenCustomizationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="⚙" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!-- Alternar Barra do Windows -->
                        <MenuItem Header="Alternar Barra do Windows"
                                  Command="{Binding DataContext.ToggleNativeTaskbarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="🪟" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator Background="{DynamicResource BarBorderBrush}" Margin="2,3" />

                        <!-- Sair do WinDock -->
                        <MenuItem Header="Sair do WinDock"
                                  Command="{Binding DataContext.ExitAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource AccentRedBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>

                <!-- Real App Icon slot -->
                <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}"
                           Width="20"
                           Height="20"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- DataTemplate for Modular Dock Widgets (Harmonized with UnifiedDockAppSlotStyle) -->
        <DataTemplate DataType="{x:Type vm:DockWidgetItem}">
            <Border x:Name="WidgetRoot"
                    Height="38"
                    Width="{Binding TargetWidth}"
                    CornerRadius="10"
                    Margin="1,0"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip="{Binding Description}"
                    PreviewMouseLeftButtonDown="DockItem_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="DockItem_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="DockItem_PreviewMouseLeftButtonUp">
                
                <!-- Right-click dark context menu for dock widgets -->
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                        <MenuItem Header="{Binding Title}" IsEnabled="False" Style="{StaticResource DarkMenuItemStyle}" FontWeight="SemiBold" />
                        <Separator Background="{DynamicResource BarBorderBrush}" Margin="2,3" />
                        <MenuItem Header="◄ Mover para a Esquerda"
                                  Command="{Binding MoveLeftCommand}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="◀" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="► Mover para a Direita"
                                  Command="{Binding MoveRightCommand}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="▶" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Background="{DynamicResource BarBorderBrush}" Margin="2,3" />
                        <MenuItem Header="Personalizar Dock..."
                                  Command="{Binding DataContext.OpenCustomizationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource DarkMenuItemStyle}">
                            <MenuItem.Icon>
                                <TextBlock Text="⚙" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Opacity" Value="0.65" />
                                <Setter Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <Grid>
                    <!-- Centered Widget Panels -->
                    <Grid>
                    <!-- HARDWARE MONITOR WIDGET -->
                    <Grid x:Name="HardwareWidgetPanel" Visibility="Collapsed" VerticalAlignment="Center">
                        <!-- 1x1: Lightning vector + CPU/RAM micro-gauges -->
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M7 1L2 8h4l-1 7 6-9H7l2-6z"
                                      Fill="{DynamicResource AccentCyanBrush}"
                                      Stretch="Uniform"
                                      Width="8" Height="13"
                                      Margin="0,0,3.5,0"
                                      VerticalAlignment="Center" />
                                <StackPanel Orientation="Vertical" Width="18" VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentCyanBrush}"
                                                 Margin="0,0,0,2.5" />
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.RamPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentGreenBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <!-- 1x2: CPU and RAM stats (Responsive) -->
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}" Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="2,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="C " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </StackPanel>
                                <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                             Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Foreground="{DynamicResource AccentCyanBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="2,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="R " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DataContext.RamText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" />
                                </StackPanel>
                                <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                             Value="{Binding DataContext.RamPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Foreground="{DynamicResource AccentGreenBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <!-- 1x3: CPU, GPU and RAM stats (Responsive) -->
                        <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}" Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="2,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="C " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </StackPanel>
                                <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                             Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Foreground="{DynamicResource AccentCyanBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="2,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="G " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DataContext.GpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurpleBrush}" />
                                </StackPanel>
                                <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                             Value="{Binding DataContext.GpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Foreground="{DynamicResource AccentPurpleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="2,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="R " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DataContext.RamText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}" />
                                </StackPanel>
                                <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                             Value="{Binding DataContext.RamPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Foreground="{DynamicResource AccentGreenBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- MEDIA & YOUTUBE WIDGET -->
                    <Grid x:Name="MediaWidgetPanel" Visibility="Collapsed">
                        <!-- 1x1: Play/Pause vector -->
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Width="36" Height="34"
                                    Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.MediaTitle, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Path Data="M4 2v12l9-6z M15 2h2v12h-2z"
                                      Stretch="Uniform"
                                      Width="13" Height="13"
                                      Fill="{DynamicResource AccentCyanBrush}" />
                            </Button>
                        </Grid>
                        <!-- 1x2: YouTube + Play/Pause + Next Track -->
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Width="23" Height="26"
                                        Command="{Binding DataContext.OpenYouTubeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Abrir YouTube">
                                    <Path Data="M10 15l5-3-5-3v6z M21.5 8c-.2-1-.9-1.8-1.9-2-1.7-.5-8.6-.5-8.6-.5s-6.9 0-8.6.5c-1 .2-1.7 1-1.9 2C0 9.7 0 12 0 12s0 2.3.5 4c.2 1 .9 1.8 1.9 2 1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5c1-.2 1.7-1 1.9-2 .5-1.7.5-4 .5-4s0-2.3-.5-4z"
                                          Width="14" Height="10" Stretch="Uniform" Fill="{DynamicResource AccentRedBrush}" />
                                </Button>
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Width="23" Height="26" Margin="2,0"
                                        Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Play / Pause">
                                    <Path Data="M3 2v10l7-5z M12 2h2v10h-2z"
                                          Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" />
                                </Button>
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Width="23" Height="26"
                                        Command="{Binding DataContext.NextTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Próxima Faixa">
                                    <Path Data="M2 2v10l6-5z M8 2v10l6-5z M14 2h2v10h-2z"
                                          Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- 1x3: Prev + Play/Pause + Next + YouTube -->
