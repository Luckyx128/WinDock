                        </Grid>
                    </Grid>

                    <!-- MEDIA & YOUTUBE WIDGET (Inspirado no card 'Fim de Tarde' com Thumbnail real/gradiente, título, artista, mini barra e botões) -->
                    <Grid x:Name="MediaWidgetPanel" Visibility="Collapsed">
                        <!-- 1x1: Thumbnail em miniatura com badge de play/pause ou ícone de mídia -->
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Width="36" Height="34"
                                    Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.MediaTitle, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border Width="26" Height="26" CornerRadius="6" ClipToBounds="True"
                                        BorderBrush="#25FFFFFF" BorderThickness="0.8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF833A" Offset="0.0" />
                                            <GradientStop Color="#E63956" Offset="0.5" />
                                            <GradientStop Color="#6C2BD9" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Image Source="{Binding DataContext.MediaThumbnail, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border Width="15" Height="15" CornerRadius="7.5"
                                                Background="#88080C14" BorderBrush="#33FFFFFF" BorderThickness="0.6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M4 2v10l7-5z" Stretch="Uniform" Width="6.5" Height="6.5" Fill="#FFFFFF" Margin="1,0,0,0" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>
                        <!-- 1x2: Thumbnail real à esquerda + Título/Canal + Mini barra de progresso + Play/Pause harmonizado -->
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}" Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail com cantos arredondados (CornerRadius 6) -->
                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" ClipToBounds="True"
                                    Margin="1,0,4,0" VerticalAlignment="Center" BorderBrush="#25FFFFFF" BorderThickness="0.8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF833A" Offset="0.0" />
                                        <GradientStop Color="#E63956" Offset="0.5" />
                                        <GradientStop Color="#6C2BD9" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="{Binding DataContext.MediaThumbnail, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                          Stretch="Uniform" Width="9" Height="9" Fill="#80FFFFFF"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Título e Artista/Canal alinhados com TextTrimming + Mini Barra Fina -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0">
                                <TextBlock Text="{Binding DataContext.MediaTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="8" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DataContext.MediaTitle, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Text="{Binding DataContext.MediaSubTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="6.8"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,-1,0,1" />
                                <ProgressBar Style="{StaticResource MiniGaugeStyle}" Height="2" Value="48"
                                             Foreground="{DynamicResource AccentCyanBrush}" Background="#25FFFFFF" />
                            </StackPanel>

                            <!-- Botão Compacto Play/Pause -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource MiniActionButtonStyle}"
                                    Width="18" Height="22"
                                    Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Play / Pause"
                                    VerticalAlignment="Center">
                                <Path Data="M3 2v10l7-5z M12 2h2v10h-2z"
                                      Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                        </Grid>
                        <!-- 1x3: Thumbnail real à esquerda + Título/Canal + Mini barra de progresso + Controles Prev/Play/Next/YouTube -->
                        <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}" Margin="3,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail real à esquerda (CornerRadius 6) -->
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" ClipToBounds="True"
                                    Margin="2,0,5,0" VerticalAlignment="Center" BorderBrush="#30FFFFFF" BorderThickness="0.8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF833A" Offset="0.0" />
                                        <GradientStop Color="#E63956" Offset="0.5" />
                                        <GradientStop Color="#6C2BD9" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="{Binding DataContext.MediaThumbnail, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                          Stretch="Uniform" Width="10" Height="10" Fill="#80FFFFFF"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Título e Artista/Canal alinhados + Mini barra de progresso -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,3,0">
                                <TextBlock Text="{Binding DataContext.MediaTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DataContext.MediaTitle, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Text="{Binding DataContext.MediaSubTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="7.2"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,-1,0,2" />
                                <ProgressBar Style="{StaticResource MiniGaugeStyle}" Height="2" Value="52"
                                             Foreground="{DynamicResource AccentCyanBrush}" Background="#25FFFFFF" />
                            </StackPanel>

                            <!-- Botões compactos de Play/Pause/Skip (MiniActionButtonStyle) harmonizados -->
