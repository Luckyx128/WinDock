                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="2,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="G " FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DataContext.GpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPurpleBrush}" />
                                </StackPanel>
                                <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                             Value="{Binding DataContext.GpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Foreground="{DynamicResource AccentPurpleBrush}" Margin="0,2,0,0" />
