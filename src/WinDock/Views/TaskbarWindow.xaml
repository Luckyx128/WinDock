<Window x:Class="WinDock.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock Taskbar"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Base Pill Button Style -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PillBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource PillHoverBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#5538BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Icon Button Style for Media / Transport Controls -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource PillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Open Window Taskbar Item Pill Style -->
        <Style x:Key="WindowPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PillBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusIndicator"
                                    Height="2.5"
                                    Width="18"
                                    CornerRadius="1.5"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,2"
                                    Background="{StaticResource TextSecondaryBrush}"
                                    Opacity="0.45" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#2A3346" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#8838BDF8" />
                                <Setter TargetName="FocusIndicator" Property="Background" Value="{StaticResource AccentCyanBrush}" />
                                <Setter TargetName="FocusIndicator" Property="Width" Value="28" />
                                <Setter TargetName="FocusIndicator" Property="Opacity" Value="1.0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.65" />
                                <Setter TargetName="FocusIndicator" Property="Width" Value="8" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource PillHoverBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Gauge Bar Style -->
        <Style x:Key="MiniGaugeBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Track" CornerRadius="2" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Glassmorphic Bar Container -->
    <Border Background="{StaticResource BarBackgroundBrush}"
            BorderBrush="{StaticResource BarBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left Zone: Brand, Live Hardware Gauges, AI Usage -->
                <ColumnDefinition Width="Auto" />
                <!-- Center Zone: Active Windows Taskbar Strip -->
                <ColumnDefinition Width="*" />
                <!-- Right Zone: Media/YouTube, Steam, Discord, Controls, Clock -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT ZONE ================= -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Brand / Native Taskbar Quick Toggle Pill -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding ToggleNativeTaskbarCommand}"
                        ToolTip="Clique para ocultar/mostrar a barra de tarefas nativa do Windows"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0"
                                Background="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="WinDock"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Hardware Telemetry Pill (CPU / GPU / RAM) -->
                <Border Background="{StaticResource PillBackgroundBrush}"
                        BorderBrush="{StaticResource BarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="10,4"
                        Margin="0,0,6,0"
                        ToolTip="{Binding RamDetailText}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- CPU -->
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CpuText}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                            </StackPanel>
                            <ProgressBar Style="{StaticResource MiniGaugeBarStyle}"
                                         Value="{Binding CpuPercent, Mode=OneWay}"
                                         Foreground="{StaticResource AccentCyanBrush}"
                                         Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- GPU -->
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GPU " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding GpuText}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" />
                            </StackPanel>
                            <ProgressBar Style="{StaticResource MiniGaugeBarStyle}"
                                         Value="{Binding GpuPercent, Mode=OneWay}"
                                         Foreground="{StaticResource AccentPurpleBrush}"
                                         Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- RAM -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RamText}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" />
                            </StackPanel>
                            <ProgressBar Style="{StaticResource MiniGaugeBarStyle}"
                                         Value="{Binding RamPercent, Mode=OneWay}"
                                         Foreground="{StaticResource AccentGreenBrush}"
                                         Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI Usage Pill -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding ToggleWidgetsCommand}"
                        ToolTip="Resumo de uso de IA hoje (clique para alternar widgets de desktop)"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5"
                                Background="{StaticResource AccentPurpleBrush}"
                                Margin="0,0,6,0" />
                        <TextBlock Text="{Binding AiBadgeText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   MaxWidth="190"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ================= CENTER ZONE: OPEN WINDOWS ================= -->
            <ScrollViewer Grid.Column="1"
                          x:Name="WindowsScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="WindowsScrollViewer_PreviewMouseWheel"
                          VerticalAlignment="Center"
                          Margin="2,0,8,0">
                <ItemsControl ItemsSource="{Binding OpenWindows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource WindowPillButtonStyle}"
                                    Command="{Binding DataContext.WindowClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Title}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="3"
                                                Background="#3338BDF8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="▪"
                                                       FontSize="9"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentCyanBrush}" />
                                        </Border>
                                        <Image Source="{Binding Icon}"
                                               Width="16"
                                               Height="16"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               MaxWidth="145"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ================= RIGHT ZONE ================= -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Media & YouTube Controller Pill -->
                <Border Background="{StaticResource PillBackgroundBrush}"
                        BorderBrush="{StaticResource BarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="8,3"
                        Margin="0,0,6,0"
                        ToolTip="{Binding MediaTitle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Source / YouTube Badge -->
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Width="Auto"
                                Padding="5,2"
                                Margin="0,0,6,0"
                                Command="{Binding OpenYouTubeCommand}"
                                ToolTip="Abrir YouTube no navegador">
                            <Border CornerRadius="5" Padding="5,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2838BDF8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsYouTubeActive}" Value="True">
                                                <Setter Property="Background" Value="#D9EF4444" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding MediaSourceBadge}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                        </Button>

                        <!-- Media Track Title -->
                        <TextBlock Text="{Binding MediaTitle}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   MaxWidth="140"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />

                        <!-- Transport Controls -->
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding PreviousTrackCommand}"
                                ToolTip="Faixa Anterior"
                                Content="⏮"
                                FontSize="11" />
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding PlayPauseCommand}"
                                ToolTip="Reproduzir / Pausar"
                                Content="⏯"
                                FontSize="11.5" />
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding NextTrackCommand}"
                                ToolTip="Próxima Faixa"
                                Content="⏭"
                                FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Steam Quick Pill -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding LaunchSelectedSteamGameCommand}"
                        ToolTip="Iniciar jogo selecionado ou abrir o cliente Steam"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentCyanBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSteamGameRunning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding SteamHeadlineText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   MaxWidth="115"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>

                <!-- Discord Status Pill -->
                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding FocusDiscordCommand}"
                        ToolTip="{Binding DiscordSubText}"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiscordRunning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding DiscordActivityText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   MaxWidth="120"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>

                <!-- Dock Utility Controls Pill (Widgets / Edge / Native Bar / Exit) -->
                <Border Background="{StaticResource PillBackgroundBrush}"
                        BorderBrush="{StaticResource BarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="4,2"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Width="Auto"
                                Padding="6,2"
                                Command="{Binding ToggleWidgetsCommand}"
                                ToolTip="Mostrar ou ocultar os Widgets no Desktop">
                            <TextBlock Text="{Binding WidgetsToggleText}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentCyanBrush}" />
                        </Button>

                        <Button Style="{StaticResource TransportButtonStyle}"
                                Width="Auto"
                                Padding="6,2"
                                Command="{Binding ToggleBarEdgeCommand}"
                                ToolTip="Alternar posição da barra (Topo / Base)">
                            <TextBlock Text="{Binding EdgeLabel}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource TransportButtonStyle}"
                                Width="22"
                                Command="{Binding ExitAppCommand}"
                                ToolTip="Sair do WinDock e restaurar a barra do Windows">
                            <TextBlock Text="✕"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#F87171" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Clock & Date Pill -->
                <Border Background="{StaticResource PillBackgroundBrush}"
                        BorderBrush="{StaticResource BarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="10,2">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentTimeText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CurrentDateText}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
