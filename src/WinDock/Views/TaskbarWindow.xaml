                                        ToolTip="Configurações de Voz &amp; Discord"
                                        Width="36" Height="30">
                                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54A.48.48 0 0 0 14 2h-4c-.25 0-.46.18-.49.42l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.63 8.48c-.14.24-.09.54.12.61l2.03 1.58c-.05.3-.07.63-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.51-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                          Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- 1x3: 3 Quick Action Buttons (Focus + DMs + Settings) (124px) -->
                        <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Command="{Binding DataContext.FocusDiscordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Abrir Janela Principal"
                                        Width="36" Height="30" Margin="0,0,3,0">
                                    <Border CornerRadius="4" Width="20" Height="20">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding DataContext.DiscordClientIcon, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border.Background>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Command="{Binding DataContext.OpenDiscordDMsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Mensagens Diretas (DMs)"
                                        Width="36" Height="30" Margin="0,0,3,0">
                                    <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                          Width="14" Height="13" Stretch="Uniform" Fill="{DynamicResource AccentCyanBrush}" />
                                </Button>
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Command="{Binding DataContext.OpenDiscordSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Ajustes de Voz"
                                        Width="36" Height="30">
                                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54A.48.48 0 0 0 14 2h-4c-.25 0-.46.18-.49.42l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.63 8.48c-.14.24-.09.54.12.61l2.03 1.58c-.05.3-.07.63-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.51-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                          Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- AI WIDGET -->
                    <Grid x:Name="AiWidgetPanel" Visibility="Collapsed">
                        <!-- 1x1: Sparkle vector icon + Counter -->
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Command="{Binding DataContext.ToggleWidgetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.AiBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="36" Height="34">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M9.5 0l2.1 5.4 5.4 2.1-5.4 2.1-2.1 5.4-2.1-5.4-5.4-2.1 5.4-2.1z"
                                          Stretch="Uniform"
                                          Width="11" Height="11"
                                          Fill="{DynamicResource AccentPurpleBrush}" />
                                    <TextBlock Text="{Binding DataContext.TotalAiInteractionsToday, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9.5" FontWeight="SemiBold"
                                               Margin="2.5,0,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- 1x2: Sparkle icon + IA request count -->
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Command="{Binding DataContext.ToggleWidgetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.AiBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="78" Height="34">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M9.5 0l2.1 5.4 5.4 2.1-5.4 2.1-2.1 5.4-2.1-5.4-5.4-2.1 5.4-2.1z"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          Fill="{DynamicResource AccentPurpleBrush}"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="IA: " FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.TotalAiInteractionsToday, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text=" req" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- 1x3: Sparkle icon + Detailed counter -->
                        <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Command="{Binding DataContext.ToggleWidgetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.AiBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="120" Height="34">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M9.5 0l2.1 5.4 5.4 2.1-5.4 2.1-2.1 5.4-2.1-5.4-5.4-2.1 5.4-2.1z"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Fill="{DynamicResource AccentPurpleBrush}"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="IA Total: " FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.TotalAiInteractionsToday, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text=" reqs" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- CLOCK WIDGET -->
                    <Grid x:Name="ClockWidgetPanel" Visibility="Collapsed">
                        <!-- 1x1: Time centered -->
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DataContext.CurrentTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <!-- 1x2: Time + Date -->
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.CurrentTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DataContext.CurrentDateText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,-1,0,0" />
                            </StackPanel>
                        </Grid>
                        <!-- 1x3: Clock icon + Time + Date -->
                        <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm.5 13H11V7h1.5v6.2l3.6 2.1-.8 1.3-4.3-2.6z"
                                      Stretch="Uniform" Width="13" Height="13" Fill="{DynamicResource AccentCyanBrush}"
                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DataContext.CurrentTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DataContext.CurrentDateText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Subtle Base Indicator Bar (harmonized with app icons FocusBar) -->
                <Border x:Name="WidgetFocusBar"
                        Height="2.5"
                        Width="12"
                        CornerRadius="1.25"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,2.5"
                        Background="{DynamicResource TextSecondaryBrush}"
                        Opacity="0.45"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="WidgetRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="WidgetFocusBar" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                    <Setter TargetName="WidgetFocusBar" Property="Width" Value="18" />
                    <Setter TargetName="WidgetFocusBar" Property="Opacity" Value="0.90" />
                </Trigger>
                <DataTrigger Binding="{Binding Id}" Value="hardware">
                    <Setter TargetName="HardwareWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="media">
                    <Setter TargetName="MediaWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam">
                    <Setter TargetName="SteamJumpInPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-jump-in">
                    <Setter TargetName="SteamJumpInPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-recent">
                    <Setter TargetName="SteamRecentPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-downloads">
                    <Setter TargetName="SteamDownloadsPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-now-playing">
                    <Setter TargetName="SteamNowPlayingPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-hub">
                    <Setter TargetName="SteamHubPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam-storage">
                    <Setter TargetName="SteamStoragePanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- DISCORD WIDGETS TRIGGERS (6 MODULAR WIDGETS) -->
                <DataTrigger Binding="{Binding Id}" Value="discord">
                    <Setter TargetName="DiscordSessionPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="discord-voice">
                    <Setter TargetName="DiscordVoicePanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="discord-controls">
                    <Setter TargetName="DiscordControlsPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="discord-mentions">
                    <Setter TargetName="DiscordMentionsPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="discord-channel">
                    <Setter TargetName="DiscordChannelPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="discord-hub">
                    <Setter TargetName="DiscordHubPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="ai">
                    <Setter TargetName="AiWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="clock">
                    <Setter TargetName="ClockWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Edge Dock Bar Container -->
    <Border Background="{DynamicResource BarBackgroundBrush}"
            BorderBrush="{DynamicResource BarBorderBrush}"
            BorderThickness="0,1,0,0">
        
        <Grid>
            <!-- Center-Aligned Scrollable Unified Dock Strip -->
            <ScrollViewer x:Name="DockScrollViewer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="DockScrollViewer_PreviewMouseWheel"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            
            <!-- ONE CLEAN UNIFIED HORIZONTAL STRIP: Open Apps + Pinned Apps (1x1 items) + One subtle gear button at the end! -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding DockScale}" ScaleY="{Binding DockScale}" />
                </StackPanel.LayoutTransform>

                <!-- Requirement (3): Botão Iniciar Windows 11 na extrema esquerda da barra (antes dos apps) -->
                <Button x:Name="Windows11StartButton"
                        Style="{StaticResource Windows11StartButtonStyle}"
                        Command="{Binding OpenStartMenuCommand}"
                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"
                        ToolTip="Iniciar (Windows 11)"
                        Margin="0,0,3,0">
                    <Grid Width="20" Height="20">
                        <!-- Windows 11 Fluent 4-Square Vector Logo -->
                        <Path Data="M2 2h7.2v7.2H2z M10.8 2H18v7.2h-7.2z M2 10.8h7.2V18H2z M10.8 10.8H18V18h-7.2z"
                              Stretch="Uniform"
                              Width="15" Height="15"
                              Fill="{DynamicResource AccentCyanBrush}">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#0078D4" Opacity="0.45" />
                            </Path.Effect>
                        </Path>
                    </Grid>
                </Button>

                <!-- Separador sutil após o botão Iniciar -->
                <Border Width="1" Height="18" Background="{DynamicResource BarBorderBrush}" Margin="2,0,4,0" Opacity="0.4"
                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}" />

                <!-- Requirement (Sprint 6): UNIFIED INTERLEAVED DOCK STRIP (Apps + Widgets freely mixed!) -->
                <!-- Combines open apps, pinned apps, and modular dock widgets in one freely reorderable horizontal strip -->
                <ItemsControl x:Name="UnifiedDockItemsControl" ItemsSource="{Binding DockStripItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Separador sutil antes do botão de engrenagem -->
                <Border Width="1" Height="18" Background="{DynamicResource BarBorderBrush}" Margin="4,0" Opacity="0.4" />

                <!-- Requirement (1): One subtle gear icon button at the end to open CustomizationWindow -->
                <Button Style="{StaticResource DockIconSlotStyle}"
                        Command="{Binding OpenCustomizationCommand}"
                        ToolTip="Personalizar Dock &amp; Configurações (⚙)">
                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                          Width="15" Height="15"
                          Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}" />
                </Button>

                <!-- Separador sutil antes do cluster Quick Settings -->
                <Border Width="1" Height="18" Background="{DynamicResource BarBorderBrush}" Margin="4,0,2,0" Opacity="0.4"
                        Visibility="{Binding ShowSystemTrayCluster, Converter={StaticResource BoolToVis}}" />

                <!-- Requirement (3): Quick Settings Cluster na extrema direita da barra (Bateria, Rede, Som) -->
                <Border x:Name="QuickSettingsCluster"
                        Height="34"
                        CornerRadius="9"
                        Background="#141924"
                        BorderBrush="{DynamicResource BarBorderBrush}"
                        BorderThickness="1"
                        Padding="3,2"
                        Margin="2,0,0,0"
                        Visibility="{Binding ShowSystemTrayCluster, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 1. Bateria (Status de Carga / AC) -->
                        <Button Style="{StaticResource QuickSettingsItemButtonStyle}"
                                Command="{Binding OpenQuickSettingsCommand}"
                                ToolTip="Status da Bateria: Carregado / Energia AC (Clique para abrir Configurações Rápidas)">
                            <Path Data="M16 8h-1V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-2h1a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1zm-3 8H4V6h9v10z"
                                  Stretch="Uniform" Width="13" Height="11"
                                  Fill="{DynamicResource TextSecondaryBrush}" />
                        </Button>

                        <!-- 2. Rede (Wi-Fi / Ethernet Conectado) -->
                        <Button Style="{StaticResource QuickSettingsItemButtonStyle}"
                                Command="{Binding OpenNetworkSettingsCommand}"
                                ToolTip="Rede &amp; Internet: Conexão ativa (Clique para abrir Configurações de Rede)">
                            <Path Data="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98A16.88 16.88 0 0 0 12 4zm0 4c3.34 0 6.39 1.25 8.74 3.31L12 19.9 3.26 11.31A13.4 13.4 0 0 1 12 8z"
                                  Stretch="Uniform" Width="13" Height="11"
                                  Fill="{DynamicResource AccentCyanBrush}" />
                        </Button>

                        <!-- 3. Som (Alto-falante / Áudio) -->
                        <Button Style="{StaticResource QuickSettingsItemButtonStyle}"
                                Command="{Binding OpenVolumeMixerCommand}"
                                ToolTip="Áudio: Mixer de Volume &amp; Dispositivos de Som (Clique para abrir Mixer de Volume)">
                            <Path Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                                  Stretch="Uniform" Width="13" Height="11"
                                  Fill="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Edge Resize Grip (allows dragging border to scale dock height) -->
        <Border x:Name="DockResizeGrip"
                Height="5"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Cursor="SizeNS"
                Background="#01FFFFFF"
                ToolTip="Arraste para redimensionar a altura da Dock (ou use Ctrl + Scroll do mouse)"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" />
    </Grid>
</Border>
</Window>
