                    </Grid>

                    <!-- AI WIDGET -->
                    <Grid x:Name="AiWidgetPanel" Visibility="Collapsed">
                        <!-- 1x1: Sparkle vector icon + Counter -->
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Command="{Binding DataContext.ToggleWidgetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.AiBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="36" Height="34">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M9.5 0l2.1 5.4 5.4 2.1-5.4 2.1-2.1 5.4-2.1-5.4-5.4-2.1 5.4-2.1z"
                                          Stretch="Uniform"
                                          Width="11" Height="11"
                                          Fill="{DynamicResource AccentPurpleBrush}" />
                                    <TextBlock Text="{Binding DataContext.TotalAiInteractionsToday, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="9.5" FontWeight="SemiBold"
                                               Margin="2.5,0,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- 1x2: Sparkle icon + IA request count -->
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Command="{Binding DataContext.ToggleWidgetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.AiBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="78" Height="34">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M9.5 0l2.1 5.4 5.4 2.1-5.4 2.1-2.1 5.4-2.1-5.4-5.4-2.1 5.4-2.1z"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          Fill="{DynamicResource AccentPurpleBrush}"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="IA: " FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.TotalAiInteractionsToday, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text=" req" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- 1x3: Sparkle icon + Detailed counter -->
                        <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Command="{Binding DataContext.ToggleWidgetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.AiBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="120" Height="34">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M9.5 0l2.1 5.4 5.4 2.1-5.4 2.1-2.1 5.4-2.1-5.4-5.4-2.1 5.4-2.1z"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          Fill="{DynamicResource AccentPurpleBrush}"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="IA Total: " FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.TotalAiInteractionsToday, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text=" reqs" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- CLOCK WIDGET -->
                    <Grid x:Name="ClockWidgetPanel" Visibility="Collapsed">
                        <!-- 1x1: Time centered -->
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DataContext.CurrentTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <!-- 1x2: Time + Date -->
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.CurrentTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DataContext.CurrentDateText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,-1,0,0" />
                            </StackPanel>
                        </Grid>
                        <!-- 1x3: Clock icon + Time + Date -->
                        <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm.5 13H11V7h1.5v6.2l3.6 2.1-.8 1.3-4.3-2.6z"
                                      Stretch="Uniform" Width="13" Height="13" Fill="{DynamicResource AccentCyanBrush}"
