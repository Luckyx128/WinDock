<Window x:Class="WinDock.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BarBackgroundBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontWeight="Normal">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Modern Dark Glassmorphic ContextMenu Style -->
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource WindowCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark MenuItem Style -->
        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="6,0,8,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1x1 Standard Icon Slot Button Style (40x40) -->
        <Style x:Key="DockIconSlotStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified 1x1 Dock App Slot Style (40x40) with real icon and active/focus indicator bar -->
        <Style x:Key="UnifiedDockAppSlotStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="2">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <!-- Subtle Focus / Open Indicator Bar at bottom (NO text labels next to icons!) -->
                            <Border x:Name="FocusBar"
                                    Height="2.5"
                                    Width="12"
                                    CornerRadius="1.25"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,2.5"
                                    Background="{DynamicResource TextSecondaryBrush}"
                                    Opacity="0.45"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- If Open, show indicator bar -->
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter TargetName="FocusBar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- If Focused, glowing accent bar and pill highlight -->
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                <Setter TargetName="FocusBar" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                                <Setter TargetName="FocusBar" Property="Width" Value="22" />
                                <Setter TargetName="FocusBar" Property="Opacity" Value="1.0" />
                            </DataTrigger>
                            <!-- If Minimized, subtle dimmed look -->
                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.60" />
                                <Setter TargetName="FocusBar" Property="Width" Value="6" />
                                <Setter TargetName="FocusBar" Property="Opacity" Value="0.25" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PillActiveBrush}" />
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Transport Button Style -->
        <Style x:Key="MiniActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiniBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MiniBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Gauge Progress Bar -->
        <Style x:Key="MiniGaugeStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3.5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="1.75" />
                            <Border x:Name="PART_Track" CornerRadius="1.75" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="1.75" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplate for Modular Dock Widgets (Can be enabled via CustomizationWindow) -->
        <DataTemplate x:Key="DockWidgetTemplate">
            <Border Height="38"
                    Width="{Binding TargetWidth}"
                    Background="{DynamicResource PillBackgroundBrush}"
                    BorderBrush="{DynamicResource BarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="2,0"
                    Padding="4,2"
                    ToolTip="{Binding Description}">
                
                <Grid VerticalAlignment="Center">
                    <!-- HARDWARE MONITOR WIDGET -->
                    <Grid x:Name="HardwareWidgetPanel" Visibility="Collapsed">
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <StackPanel Orientation="Vertical" Width="18" VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentCyanBrush}"
                                                 Margin="0,0,0,2.5" />
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.RamPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentGreenBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" Width="40" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="C " FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentCyanBrush}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentCyanBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Width="40">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="R " FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.RamText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentGreenBrush}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.RamPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentGreenBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Visibility="{Binding IsSize1x3, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" Width="44" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="CPU " FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.CpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentCyanBrush}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.CpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentCyanBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Width="44" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="GPU " FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.GpuText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentPurpleBrush}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.GpuPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentPurpleBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Width="44">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="RAM " FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DataContext.RamText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource AccentGreenBrush}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource MiniGaugeStyle}"
                                                 Value="{Binding DataContext.RamPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Foreground="{DynamicResource AccentGreenBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- MEDIA & YOUTUBE WIDGET -->
                    <Grid x:Name="MediaWidgetPanel" Visibility="Collapsed">
                        <Grid Visibility="{Binding IsSize1x1, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.MediaTitle, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="⏯" FontSize="12" Foreground="{DynamicResource AccentCyanBrush}" />
                            </Button>
                        </Grid>
                        <Grid Visibility="{Binding IsSize1x2, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Command="{Binding DataContext.OpenYouTubeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Abrir YouTube">
                                    <Border CornerRadius="4" Padding="3,1" Background="#2638BDF8">
                                        <TextBlock Text="▶" FontSize="8.5" FontWeight="Medium" Foreground="{DynamicResource AccentCyanBrush}" />
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Play / Pause" Content="⏯" FontSize="11" Margin="2,0" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Command="{Binding DataContext.NextTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Próxima Faixa" Content="⏭" FontSize="10.5" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- STEAM WIDGET -->
                    <Grid x:Name="SteamWidgetPanel" Visibility="Collapsed">
                        <Button Style="{StaticResource MiniActionButtonStyle}"
                                Command="{Binding DataContext.LaunchSelectedSteamGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{Binding DataContext.SteamHeadlineText, RelativeSource={RelativeSource AncestorType=Window}}"
                                Width="36" Height="34">
                            <TextBlock Text="🎮" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- DISCORD WIDGET -->
                    <Grid x:Name="DiscordWidgetPanel" Visibility="Collapsed">
                        <Button Style="{StaticResource MiniActionButtonStyle}"
                                Command="{Binding DataContext.FocusDiscordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{Binding DataContext.DiscordSubText, RelativeSource={RelativeSource AncestorType=Window}}"
                                Width="36" Height="34">
                            <TextBlock Text="💬" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- AI WIDGET -->
                    <Grid x:Name="AiWidgetPanel" Visibility="Collapsed">
                        <Button Style="{StaticResource MiniActionButtonStyle}"
                                Command="{Binding DataContext.ToggleWidgetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{Binding DataContext.AiBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                Width="36" Height="34">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✨" FontSize="11" Foreground="{DynamicResource AccentPurpleBrush}" />
                                <TextBlock Text="{Binding DataContext.TotalAiInteractionsToday, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="9.5" FontWeight="Medium" Margin="2,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- CLOCK WIDGET -->
                    <Grid x:Name="ClockWidgetPanel" Visibility="Collapsed">
                        <TextBlock Text="{Binding DataContext.CurrentTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="hardware">
                    <Setter TargetName="HardwareWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="media">
                    <Setter TargetName="MediaWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="steam">
                    <Setter TargetName="SteamWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="discord">
                    <Setter TargetName="DiscordWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="ai">
                    <Setter TargetName="AiWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="clock">
                    <Setter TargetName="ClockWidgetPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Edge Dock Bar Container -->
    <Border Background="{DynamicResource BarBackgroundBrush}"
            BorderBrush="{DynamicResource BarBorderBrush}"
            BorderThickness="0,1,0,0">
        
        <!-- Center-Aligned Scrollable Unified Dock Strip -->
        <ScrollViewer x:Name="DockScrollViewer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="DockScrollViewer_PreviewMouseWheel"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            
            <!-- ONE CLEAN UNIFIED HORIZONTAL STRIP: Open Apps + Pinned Apps (1x1 items) + One subtle gear button at the end! -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">

                <!-- Requirement (2): UNIFIED DOCK APPS (1x1 40x40 items) -->
                <!-- Combines user-pinned apps and open windows into one unified collection with real icons & active indicators! -->
                <ItemsControl ItemsSource="{Binding DockApps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource UnifiedDockAppSlotStyle}"
                                    Command="{Binding ClickCommand}"
                                    ToolTip="{Binding Title}">
                                
                                <!-- Right-click dark context menu for any app icon -->
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                        <!-- Fixar / Desafixar da Dock: saves to JSON immediately! -->
                                        <MenuItem Header="{Binding PinMenuText}"
                                                  Command="{Binding TogglePinCommand}"
                                                  Style="{StaticResource DarkMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="📌" FontSize="11" Foreground="{DynamicResource AccentColorBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator Background="{DynamicResource BarBorderBrush}" Margin="2,3" />

                                        <!-- Personalizar Dock... -->
                                        <MenuItem Header="Personalizar Dock..."
                                                  Command="{Binding DataContext.OpenCustomizationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource DarkMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="⚙" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Alternar Barra do Windows -->
                                        <MenuItem Header="Alternar Barra do Windows"
                                                  Command="{Binding DataContext.ToggleNativeTaskbarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource DarkMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="🪟" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator Background="{DynamicResource BarBorderBrush}" Margin="2,3" />

                                        <!-- Sair do WinDock -->
                                        <MenuItem Header="Sair do WinDock"
                                                  Command="{Binding DataContext.ExitAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource DarkMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource AccentRedBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <!-- Real App Icon slot -->
                                <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}"
                                           Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Modular Dock Widgets (all IsVisible=false by default so dock starts 100% clean) -->
                <ItemsControl ItemsSource="{Binding DockWidgets}"
                              ItemTemplate="{StaticResource DockWidgetTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- Subtle Separator before settings gear button -->
                <Border Width="1" Height="18" Background="{DynamicResource BarBorderBrush}" Margin="4,0" Opacity="0.4" />

                <!-- Requirement (1): One subtle gear icon button at the end to open CustomizationWindow -->
                <Button Style="{StaticResource DockIconSlotStyle}"
                        Command="{Binding OpenCustomizationCommand}"
                        ToolTip="Personalizar Dock &amp; Configurações (⚙)">
                    <TextBlock Text="⚙" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
