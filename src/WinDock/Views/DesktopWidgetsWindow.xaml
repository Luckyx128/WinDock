<Window x:Class="WinDock.Views.DesktopWidgetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock Desktop Widgets"
        Width="360"
        Height="740"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontWeight="Normal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Glassmorphic Widget Card Style -->
        <Style x:Key="WidgetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Widget Action Pill Button Style -->
        <Style x:Key="WidgetPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-Width Gauge ProgressBar Style -->
        <Style x:Key="WidgetGaugeBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Track" CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Vertical" Margin="6">

        <!-- ================= WIDGET 1: HEADER & HARDWARE GAUGES ================= -->
        <Border Style="{StaticResource WidgetCardStyle}"
                MouseLeftButtonDown="HeaderCard_MouseLeftButtonDown"
                Cursor="SizeAll"
                ToolTip="Arraste para reposicionar os widgets no desktop">
            <StackPanel>
                <!-- Header Row -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding GreetingText}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="TELEMETRIA DO SISTEMA"
                                   FontSize="9"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding RefreshAllCommand}"
                            Padding="8,3"
                            ToolTip="Atualizar métricas agora">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"
                                  Fill="{DynamicResource AccentColorBrush}"
                                  Stretch="Uniform"
                                  Width="10" Height="10"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Sincronizar"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource AccentColorBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- CPU Gauge -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Processador (CPU)"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuText}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AccentCyanBrush}" />
                </Grid>
                <ProgressBar Style="{StaticResource WidgetGaugeBarStyle}"
                             Value="{Binding CpuPercent, Mode=OneWay}"
                             Foreground="{DynamicResource AccentCyanBrush}"
                             Margin="0,0,0,8" />

                <!-- GPU Gauge -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Placa Gráfica (GPU)"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuText}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AccentPurpleBrush}" />
                </Grid>
                <ProgressBar Style="{StaticResource WidgetGaugeBarStyle}"
                             Value="{Binding GpuPercent, Mode=OneWay}"
                             Foreground="{DynamicResource AccentPurpleBrush}"
                             Margin="0,0,0,8" />

                <!-- RAM Gauge -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Memória (RAM)"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RamDetailText}"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AccentGreenBrush}" />
                </Grid>
                <ProgressBar Style="{StaticResource WidgetGaugeBarStyle}"
                             Value="{Binding RamPercent, Mode=OneWay}"
                             Foreground="{DynamicResource AccentGreenBrush}" />
            </StackPanel>
        </Border>

        <!-- ================= WIDGET 2: MEDIA & YOUTUBE HUB ================= -->
        <Border Style="{StaticResource WidgetCardStyle}" Padding="0" ClipToBounds="True">
            <Grid>
                <!-- Background com a Thumbnail da Mídia (Estilo Steam, Opacidade 0.30) -->
                <Border CornerRadius="12">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding MediaThumbnail}"
                                    Stretch="UniformToFill" Opacity="0.30"
                                    RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border.Background>
                </Border>
                <!-- Overlay escuro translúcido para contraste perfeito de leitura -->
                <Border CornerRadius="12" Background="#770A0E18" />

                <!-- Conteúdo do Card com Espaçamento Limpo -->
                <StackPanel Margin="14">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MÍDIA &amp; YOUTUBE"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1" CornerRadius="5" Padding="6,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2838BDF8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsYouTubeActive}" Value="True">
                                            <Setter Property="Background" Value="#D9EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding MediaSourceBadge}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding MediaTitle}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,2" />

                    <TextBlock Text="{Binding MediaSubTitle}"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,10" />

                    <!-- Controles de Reprodução Limpos (Botão YouTube removido para foco total na mídia) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource WidgetPillButtonStyle}"
                                Command="{Binding PreviousTrackCommand}"
                                Margin="0,0,6,0"
                                Padding="10,4"
                                Content="⏮" />
                        <Button Grid.Column="1"
                                Style="{StaticResource WidgetPillButtonStyle}"
                                Command="{Binding PlayPauseCommand}"
                                Margin="0,0,6,0"
                                Padding="14,4"
                                Content="⏯ Play / Pause" />
                        <Button Grid.Column="2"
                                Style="{StaticResource WidgetPillButtonStyle}"
                                Command="{Binding NextTrackCommand}"
                                Margin="0,0,6,0"
                                Padding="10,4"
                                Content="⏭" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= WIDGET 3: AI USAGE SUMMARY ================= -->
        <Border Style="{StaticResource WidgetCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5"
                                Background="{DynamicResource AccentPurpleBrush}"
                                Margin="0,0,6,0" />
                        <TextBlock Text="USO DE IA LOCAL (HOJE)"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#28A855F7"
                            CornerRadius="5"
                            Padding="6,2">
                        <TextBlock Text="{Binding AiActiveModelSummary}"
                                   FontSize="9"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource AccentPurpleBrush}" />
                    </Border>
                </Grid>

                <!-- Total Interactions Counter -->
                <Border Background="{DynamicResource PillBackgroundBrush}"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Interações registradas hoje"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalAiInteractionsToday}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Per-Provider Breakdown -->
                <ItemsControl ItemsSource="{Binding AiProviders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#12FFFFFF"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActiveNow}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="{Binding ProviderName}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock FontSize="9"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding SessionsToday, Mode=OneWay}" />
                                            <Run Text=" sessões · " />
                                            <Run Text="{Binding StorageKb, Mode=OneWay}" />
                                            <Run Text=" KB" />
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               FontSize="10.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource AccentCyanBrush}">
                                        <Run Text="{Binding InteractionsToday, Mode=OneWay}" />
                                        <Run Text=" reqs" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ================= WIDGET 4: STEAM & DISCORD HUB ================= -->
        <Border Style="{StaticResource WidgetCardStyle}" Margin="0">
            <StackPanel>
                <!-- Discord Status Section -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiscordRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding DiscordActivityText}"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding DiscordSubText}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="13,1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding FocusDiscordCommand}"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="Discord"
                                   FontSize="10.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource AccentPurpleBrush}" />
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource BarBorderBrush}" Margin="0,0,0,8" />

                <!-- Steam Header -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SteamHeadlineText}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SteamSubText}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding OpenSteamCommand}"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="Abrir Steam"
                                   FontSize="10.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource AccentCyanBrush}" />
                    </Button>
                </Grid>

                <!-- Installed Steam Games Quick Launcher List -->
                <ScrollViewer MaxHeight="110"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding InstalledGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PillBackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        Margin="0,0,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,6,0" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource WidgetPillButtonStyle}"
                                                Padding="7,2"
                                                Command="{Binding DataContext.LaunchSteamGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="▶ Jogar"
                                                       FontSize="9.5"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource AccentGreenBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>