<Window x:Class="WinDock.Views.DesktopWidgetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock Desktop Widgets"
        Width="356"
        Height="740"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Glassmorphic Widget Card Style -->
        <Style x:Key="WidgetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BarBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Widget Action Pill Button Style -->
        <Style x:Key="WidgetPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PillBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource PillHoverBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-Width Gauge ProgressBar Style -->
        <Style x:Key="WidgetGaugeBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3.5" />
                            <Border x:Name="PART_Track" CornerRadius="3.5" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3.5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Vertical" Margin="6">

        <!-- ================= WIDGET 1: HEADER & HARDWARE GAUGES ================= -->
        <Border Style="{StaticResource WidgetCardStyle}"
                MouseLeftButtonDown="HeaderCard_MouseLeftButtonDown"
                Cursor="SizeAll"
                ToolTip="Arraste para reposicionar os widgets no desktop">
            <StackPanel>
                <!-- Header Row -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding GreetingText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="TELEMETRIA DE HARDWARE EM TEMPO REAL"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding RefreshAllCommand}"
                            Padding="8,3"
                            ToolTip="Atualizar métricas agora">
                        <TextBlock Text="↻ Sync"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                    </Button>
                </Grid>

                <!-- CPU Gauge -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Processador (CPU)"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CpuText}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" />
                </Grid>
                <ProgressBar Style="{StaticResource WidgetGaugeBarStyle}"
                             Value="{Binding CpuPercent, Mode=OneWay}"
                             Foreground="{StaticResource AccentCyanBrush}"
                             Margin="0,0,0,9" />

                <!-- GPU Gauge -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Placa Gráfica (GPU 3D)"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GpuText}"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentPurpleBrush}" />
                </Grid>
                <ProgressBar Style="{StaticResource WidgetGaugeBarStyle}"
                             Value="{Binding GpuPercent, Mode=OneWay}"
                             Foreground="{StaticResource AccentPurpleBrush}"
                             Margin="0,0,0,9" />

                <!-- RAM Gauge -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Memória Física (RAM)"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RamDetailText}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentGreenBrush}" />
                </Grid>
                <ProgressBar Style="{StaticResource WidgetGaugeBarStyle}"
                             Value="{Binding RamPercent, Mode=OneWay}"
                             Foreground="{StaticResource AccentGreenBrush}" />
            </StackPanel>
        </Border>

        <!-- ================= WIDGET 2: MEDIA & YOUTUBE HUB ================= -->
        <Border Style="{StaticResource WidgetCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MÍDIA &amp; YOUTUBE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1" CornerRadius="6" Padding="7,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#2838BDF8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsYouTubeActive}" Value="True">
                                        <Setter Property="Background" Value="#D9EF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding MediaSourceBadge}"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                </Grid>

                <TextBlock Text="{Binding MediaTitle}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2" />

                <TextBlock Text="{Binding MediaSubTitle}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding PreviousTrackCommand}"
                            Margin="0,0,6,0"
                            Content="⏮" />
                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding PlayPauseCommand}"
                            Margin="0,0,6,0"
                            Padding="14,5"
                            Content="⏯ Play / Pause" />
                    <Button Grid.Column="2"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding NextTrackCommand}"
                            Margin="0,0,8,0"
                            Content="⏭" />
                    <Button Grid.Column="3"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding OpenYouTubeCommand}"
                            HorizontalAlignment="Right">
                        <TextBlock Text="▶ YouTube"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#F87171" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= WIDGET 3: AI USAGE SUMMARY ================= -->
        <Border Style="{StaticResource WidgetCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{StaticResource AccentPurpleBrush}"
                                Margin="0,0,6,0" />
                        <TextBlock Text="USO DE IA LOCAL (HOJE)"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#28A855F7"
                            CornerRadius="6"
                            Padding="7,2">
                        <TextBlock Text="{Binding AiActiveModelSummary}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentPurpleBrush}" />
                    </Border>
                </Grid>

                <!-- Total Interactions Counter -->
                <Border Background="{StaticResource PillBackgroundBrush}"
                        CornerRadius="10"
                        Padding="10,7"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Interações registradas hoje"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalAiInteractionsToday}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Per-Provider Breakdown -->
                <ItemsControl ItemsSource="{Binding AiProviders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#16FFFFFF"
                                    CornerRadius="8"
                                    Padding="9,5"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="6" Height="6"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Margin="0,0,7,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActiveNow}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="{Binding ProviderName}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock FontSize="9.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding SessionsToday, Mode=OneWay}" />
                                            <Run Text=" sessões · " />
                                            <Run Text="{Binding StorageKb, Mode=OneWay}" />
                                            <Run Text=" KB" />
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}">
                                        <Run Text="{Binding InteractionsToday, Mode=OneWay}" />
                                        <Run Text=" reqs" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ================= WIDGET 4: STEAM & DISCORD HUB ================= -->
        <Border Style="{StaticResource WidgetCardStyle}" Margin="0">
            <StackPanel>
                <!-- Discord Status Section -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiscordRunning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding DiscordActivityText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding DiscordSubText}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="14,1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding FocusDiscordCommand}"
                            VerticalAlignment="Center">
                        <TextBlock Text="Discord"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentPurpleBrush}" />
                    </Button>
                </Grid>

                <Border Height="1" Background="{StaticResource BarBorderBrush}" Margin="0,0,0,10" />

                <!-- Steam Header -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SteamHeadlineText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SteamSubText}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetPillButtonStyle}"
                            Command="{Binding OpenSteamCommand}"
                            VerticalAlignment="Center">
                        <TextBlock Text="Abrir Steam"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                    </Button>
                </Grid>

                <!-- Installed Steam Games Quick Launcher List -->
                <ScrollViewer MaxHeight="118"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding InstalledGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PillBackgroundBrush}"
                                        CornerRadius="8"
                                        Padding="9,4"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource WidgetPillButtonStyle}"
                                                Padding="8,2"
                                                Command="{Binding DataContext.LaunchSteamGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="▶ Jogar"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentGreenBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
